{
  "name": "madevi-off",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pondasi lokal Madevi untuk Termux Android",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start:direct": "next start --hostname 127.0.0.1 --port 3000",
    "stop": "node scripts/stop.mjs",
    "status": "node scripts/status.mjs",
    "restart": "node scripts/restart.mjs --mode production-local",
    "deps:check": "node scripts/check-deps.mjs",
    "setup:local": "node scripts/setup.mjs",
    "db:check": "node scripts/check-postgres.mjs",
    "db:bootstrap:termux": "node scripts/postgres-termux.mjs bootstrap",
    "db:start": "node scripts/postgres-termux.mjs start",
    "db:status": "node scripts/postgres-termux.mjs status",
    "db:stop": "node scripts/postgres-termux.mjs stop",
    "db:bootstrap:proot": "node scripts/bootstrap-postgres-proot.mjs",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:migrate:status": "node scripts/migrate.mjs status",
    "db:seed:test": "node database/seeds/scripts/seed.mjs",
    "seed:simulation": "node database/seeds/scripts/seed-simulation.mjs",
    "seed:articles-pilot": "node database/seeds/scripts/seed-articles-pilot-explore.mjs",
    "db:rotate-local-credential": "node scripts/rotate-local-db-credential.mjs --confirm-local-rotation",
    "auth:ensure-local-config": "node scripts/ensure-auth-config.mjs",
    "taxonomy:preview": "node scripts/taxonomy-import.mjs preview",
    "taxonomy:pilot-preview": "node scripts/taxonomy-import.mjs preview --expected-base 0 --package content-local/packages/taxonomy/madevi-explore-pilot-v1.json",
    "taxonomy:pilot-stage": "node scripts/taxonomy-import.mjs stage --expected-base 0 --package content-local/packages/taxonomy/madevi-explore-pilot-v1.json",
    "taxonomy:package:preview": "node scripts/taxonomy-import.mjs preview --expected-base 0 --package content-local/packages/taxonomy/madevi-explore-pilot-v1.json",
    "taxonomy:package:stage": "node scripts/taxonomy-import.mjs stage --expected-base 0 --package content-local/packages/taxonomy/madevi-explore-pilot-v1.json",
    "taxonomy:stage": "node scripts/taxonomy-import.mjs stage",
    "taxonomy:status": "node scripts/taxonomy-import.mjs status",
    "taxonomy:promote": "node scripts/taxonomy-import.mjs promote",
    "taxonomy:abort": "node scripts/taxonomy-import.mjs abort",
    "taxonomy:export": "node scripts/taxonomy-import.mjs export",
    "backup:local": "node scripts/backup.mjs",
    "restore:local": "node scripts/restore.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "inspect:restore": "node scripts/inspect-restore.mjs --manifest backup-local/manifest.json --target-runtime-root backup-local/restore-targets/inspect",
    "release:check": "node scripts/check-release-cleanliness.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:task-lock && npm run build"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "animejs": "4.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "13.4.4",
    "gsap": "3.15.0",
    "next": "16.3.4",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "happy-dom": "20.14.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
