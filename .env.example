# Nilai lokal contoh. Salin ke .env.local di folder aplikasi Madevi_Off.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://madevi_local:GANTI_PASSWORD_LOKAL@127.0.0.1:5432/madevi_off
MADEVI_RUNTIME_ROOT=/sdcard/project/Madevi/Madevi_Off/cloud-local
MADEVI_DB_SCHEMA=madevi
LOG_LEVEL=info
# Isi hanya di .env.local untuk seed manual localhost; jangan commit nilainya.
SIMULATION_ADMIN_PASSWORD=
SIMULATION_USER_PASSWORD=
# Secret acak khusus webhook fixture Prompt 12. Isi hanya .env.local; jangan commit nilainya.
PAYMENT_WEBHOOK_MOCK_SECRET=
